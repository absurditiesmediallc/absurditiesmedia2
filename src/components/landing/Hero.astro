---
import { Image } from 'astro:assets';
import Banner from "@/components/landing/Banner.astro";
import Testimonials from "@/components/landing/Testimonials.astro";
const {heroText, heroImage, heroImageAlt} = Astro.props;
---

<section class="border-white/20  border-b">
  <div class="mx-auto border-white/20 border-x lg:max-w-7xl">
    <div class="mx-auto">
      <div style="clear:both;"></div>
      <div class="mx-auto lg:pt-28 p-4 lg:px-8 lg:py-12">    
    
        <h1 class="text-white font-display uppercase text-3xl lg:text-7xl pb-8">{heroText}</h1>
        {(heroImage)?<Image src={heroImage} alt={heroImageAlt}/>:""} 
      
      </div>
      <Banner bannerText="Your Family ✺ Will Betray You ✺ Your Investments ✺ Will Not Protect You ✺ Your Sense of Security ✺ Is an Illusion"  />
      <!--<Testimonials />-->
    </div>
  </div>
</section>
