---
import BaseHead from "@/components/BaseHead.astro";
import Navigation from "@/components/global/Navigation.astro";
import Footer from "@/components/global/Footer.astro";
const { data } = Astro.props;
import GradientGrid from '@/components/landing/GradientGrid.astro';
import SolidGrid from '@/components/landing/SolidGrid.astro';

---

<html lang="en" class="selection:bg-carrot selection:text-white">
  <head>
    <BaseHead {...data}/>
  </head>
  <body class="mx-auto bg-black max-w-7xl">
  <Navigation />
    <slot />
    <Footer />
  </body>
</html>
